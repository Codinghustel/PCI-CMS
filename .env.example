# PCI-Orbit — environment configuration.
# Copy to `.env` for local development. Never commit real values; in staging and
# production set these in the hosting platform's secret manager.

# ── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection (UTF-8 database). Local dev: `npm run db:start`.
DATABASE_URL="postgresql://pci:pci_local_only@localhost:54329/pci_dev"

# Secret used to sign CMS session tokens. 32+ random characters, unique per
# environment. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# "production" allows search-engine indexing. Anything else (development,
# staging) serves robots noindex + X-Robots-Tag on every response.
SITE_ENV="development"

# Other sites allowed to show the CMS inside a frame (space-separated origins).
# Defaults to PCI Orbit (https://apps.premierchoiceint.online); set to "" to allow none.
# FRAME_ANCESTORS="https://apps.premierchoiceint.online"

# ── File storage ────────────────────────────────────────────────────────────
# Public media library files and private files (CVs). Use persistent volumes.
UPLOAD_DIR="./storage/public"
PRIVATE_UPLOAD_DIR="./storage/private"

# ── Bitrix24 CRM (lead delivery) ────────────────────────────────────────────
# Inbound webhook with CRM scope, e.g. https://<portal>.bitrix24.com/rest/<user>/<code>/
# Leave empty to store leads only (they are delivered once this is set).
BITRIX24_WEBHOOK_URL=""
# Optional custom lead field code that receives the project's Bitrix24 id (e.g. UF_CRM_PROJECT).
BITRIX24_PROJECT_FIELD=""
# Optional default responsible user id for new leads.
BITRIX24_DEFAULT_ASSIGNEE_ID=""

# ── Scheduled job ───────────────────────────────────────────────────────────
# Bearer token for POST /api/cron/deliver-leads (CRM retries + housekeeping).
# Schedule it every 1–5 minutes. 16+ characters.
CRON_SECRET=""

# ── External user provisioning ──────────────────────────────────────────────
# Bearer key for /api/v1/users and /api/v1/roles (other apps creating CMS
# users and changing role permissions).
# 32+ characters; leave empty to disable the endpoint.
USERS_API_KEY=""

# ── PCI Orbit single sign-on ────────────────────────────────────────────────
# Everyone signs in through PCI Orbit (app key "cms"; callback <site>/admin/sso/callback).
# The app secret is USERS_API_KEY above (Orbit's CMS_API_KEY).
ORBIT_URL="https://apps.premierchoiceint.online"
# Emergency only: "true" turns the email/password form back on.
ALLOW_PASSWORD_LOGIN="false"

# ── Payment Service (Track C) ───────────────────────────────────────────────
# When both are set, "Pay My Installment" hands off to the verified payment
# service. When empty, the interim payment-request form (via Bitrix24) is used.
PAYMENT_SERVICE_URL=""
PAYMENT_SERVICE_SECRET=""

# ── Seeding (development / first install only) ─────────────────────────────
# SEED_ADMIN_EMAIL="admin@pci-orbit.local"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
# SEED_DEMO_USERS="true"      # creates editor/author/approver/viewer accounts (non-production)
# SEED_DEMO_PASSWORD=""
# SEED_FORCE="false"
